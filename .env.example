# Copy to .env. Never commit real API keys.
AI_MODE=fixture
GROQ_API_KEY=
GEMINI_API_KEY=
TRANSCRIPTION_MODEL=whisper-large-v3-turbo
CLIP_SELECTION_MODEL=gemini-2.5-flash-lite
DATABASE_URL=file:./data/cliploom.db
MEDIA_STORAGE_DIR=./data/media
# Blank paths use bundled dev binaries, then PATH. Full Windows paths with spaces work.
FFMPEG_PATH=
FFPROBE_PATH=
LOCAL_ORIGIN=http://localhost:3100
MAX_UPLOAD_MB=1024
MAX_DURATION_MINUTES=120
AUDIO_CHUNK_SECONDS=300
PROVIDER_MAX_FILE_MB=24
CLIP_COUNT=5
# One worker only. Concurrency is intentionally fixed at one.
JOB_MAX_ATTEMPTS=3
JOB_LEASE_SECONDS=90
