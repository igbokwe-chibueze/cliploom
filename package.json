{
  "name": "cliploom",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others --names web,worker \"npm run dev:web\" \"npm run dev:worker\"",
    "dev:web": "next dev --hostname localhost",
    "dev:worker": "tsx watch worker/index.ts",
    "worker": "tsx worker/index.ts",
    "build": "prisma generate && next build",
    "start": "next start --hostname localhost",
    "lint": "eslint src worker scripts tests prisma.config.ts next.config.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "tsx scripts/e2e.ts",
    "db:setup": "prisma migrate deploy && prisma generate",
    "db:migrate": "prisma migrate dev",
    "doctor": "tsx scripts/doctor.ts",
    "fixture:create": "tsx scripts/create-fixture.ts"
  },
  "dependencies": {
    "@google/genai": "^2.29.1",
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.7",
    "groq-sdk": "^1.6.0",
    "lucide-react": "^1.56.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.6",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "allowScripts": {
    "ffmpeg-static": true,
    "ffprobe-static": true,
    "@prisma/engines": true,
    "prisma": true,
    "esbuild": true,
    "better-sqlite3": true,
    "unrs-resolver": true,
    "protobufjs": true,
    "@google/genai": false
  }
}
